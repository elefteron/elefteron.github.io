<HTML><HEAD><TITLE>drive info</TITLE>
<HTA:APPLICATION ID=drvinfoappl applicationName=drive-info 
    border        ="thick"    // none thin dialog thick
    borderStyle   ="normal"   // normal complex static sunken raised
    windowState   ="normal"   // minimize maximize normal
    application   ="yes"      singleInstance="no" // else last overwrite same scr report
    contextMenu   ="yes"      scrollFlat    ="no"
    innerBorder   ="no"       selection     ="yes"
    maximizeButton="no"       sysMenu       ="no"                 caption="no"
    minimizeButton="no"       showInTaskBar ="yes"
    navigable     ="yes"      icon          ="../~ico/d.ico"    scroll ="no" >
<meta http-equiv="Content-Type" content="text/html; charset=windows-1251">
<META HTTP-EQUIV="refresh" CONTENT="0; URL=drv-info.4.htm">
</HEAD>
<body></BODY>
</HTML>